def search_artifact():
    """Displays the search artifact."""
    clear_screen()
    search_name = input("Enter the name of the search: ").strip()
    if search_name in artifacts:
        index = artifacts.index(search_name)
        if rented_status[index]:
            rented_status[index] = False
            print(f"You have updated '{search_name}'.")
    else:
        print("Artifact not found.")


def exit_program():
    """Exits the program gracefully."""
    print("Exiting the system. Have a great day!")
    time.sleep(2)
    sys.exit()


def main():
    """Main function to run the Artifact Management system."""
    while True:
        clear_screen()
        display_menu()
        choice = input("Enter your choice (1-9): ")

        if choice == '1':
            view_available_artifacts()
        elif choice == '2':
            add_artifact()
        elif choice == '3':
            update_artifact()
        elif choice == '4':
            delete_artifact()
        elif choice == '5':
            category_of_artifact()
        elif choice == '6':
            condition_of_artifact()
        elif choice == '7':
            location_of_artifact()
        elif choice == '8':
            search_artifact()


        elif choice == '9':
            exit()
        else:
            print("Invalid choice. Please select a valid option.")
            time.sleep(2)


# Run the artifact management system
if __name__ == "__main__":
       main()
